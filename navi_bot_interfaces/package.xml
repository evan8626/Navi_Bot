<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navi_bot_interfaces</name>
  <version>0.1.0</version>
  <description>
    Custom message interfaces for navi_bot. Provides Pose2D (x, y, theta),
    replacing geometry_msgs/Pose2D which was removed in newer ROS 2 distros.
  </description>
  <maintainer email="evan.a.osborn@gmail.com">Evan Osborn</maintainer>
  <license>MIT</license>

  <!-- ament_cmake drives the build; rosidl generators turn msg/*.msg into
       C and Python type-support at build time. -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- runtime type-support library the generated Python bindings load -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- marks this as a package that exports IDL interfaces -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
